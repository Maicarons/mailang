// try_demo.mai — the `?` try operator for Result
// Run: cargo run -p mailang-cli -- run examples/try_demo.mai

fn div(a, b) {
    if b == 0.0 {
        return Err("div0")
    }
    return Ok(a / b)
}

fn calc_ok() {
    let x = div(10.0, 2.0)?
    return Ok(x * 2.0)
}

fn calc_err() {
    let x = div(1.0, 0.0)?
    return Ok(x)
}

fn chain(a, b, c) {
    let x = div(a, b)?
    let y = div(x, c)?
    return Ok(y)
}

println(calc_ok())
println(calc_err())
println(chain(100.0, 5.0, 2.0))
println(chain(100.0, 0.0, 2.0))

// Combine `?` with match on the final Result
let r = chain(8.0, 2.0, 2.0)
match r {
    Ok(v) => println("ok: {v}")
    Err(e) => println("err: {e}")
}

let bad = chain(8.0, 0.0, 2.0)
match bad {
    Ok(v) => println("ok: {v}")
    Err(e) => println("err: {e}")
}
