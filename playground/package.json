{
  "name": "mai-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "build:wasm": "cd ../crates/mailang-wasm && wasm-pack build --target web --release",
    "build:all": "npm run build:wasm && npm run build",
