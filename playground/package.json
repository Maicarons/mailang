    "test:headed": "playwright test --headed"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/theme-one-dark": "^6.1.0",
    "@playwright/test": "^1.61.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "codemirror": "^6.0.0",
    "codemirror-lang-mai": "file:./cm-lang-mai",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^1.8.0"
  }
}
