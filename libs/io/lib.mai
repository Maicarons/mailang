// Read lines from file
fn read_lines(path) {
    let content = read_file(path)
    return [content]
}

// Write lines to file
fn write_lines(path, lines) {
    let content = ""
    for line in lines {
        content = content + line + "\n"
    }
    return write_file(path, content)
}
