// io 模块测试

import "io"

let passed = 0
let failed = 0

fn assert(condition, msg) {
    if condition {
        passed = passed + 1
        println("  PASS: {msg}")
    } else {
        failed = failed + 1
        println("  FAIL: {msg}")
    }
}

println("=== io 模块测试 ===")
println("")

let test_file = "/tmp/mailang_test_io.txt"
let test_file2 = "/tmp/mailang_test_io2.txt"

// 测试 write_file
println("测试 write_file:")
let result = io.write_file(test_file, "Hello, World!")
assert(result == true, "write_file 返回 true")

// 测试 file_exists
println("测试 file_exists:")
assert(io.file_exists(test_file) == true, "file_exists 对已创建文件返回 true")
assert(io.file_exists("/tmp/nonexistent_file_12345.txt") == false, "file_exists 对不存在文件返回 false")

// 测试 read_file
println("测试 read_file:")
let content = io.read_file(test_file)
assert(content == "Hello, World!", "read_file 返回正确内容")

// 测试 read_lines
println("测试 read_lines:")
io.write_file(test_file, "line1\nline2\nline3")
let lines = io.read_lines(test_file)
assert(len(lines) == 3, "read_lines 返回正确行数")

// 测试 write_lines
println("测试 write_lines:")
let result2 = io.write_lines(test_file2, ["aaa", "bbb", "ccc"])
assert(result2 == true, "write_lines 返回 true")
let content2 = io.read_file(test_file2)
assert(content2 == "aaa\nbbb\nccc\n", "write_lines 内容正确")

println("")
println("=== 测试结果 ===")
println("通过: {passed}")
println("失败: {failed}")
println("总计: {passed + failed}")

if failed > 0 {
    println("ERROR: 有测试失败!")
}
