// array 模块基础使用示例

import "array"

println("=== array 模块示例 ===")
println("")

// 创建数组
println("创建数组:")
let arr1 = array.new(5, 0)
println("  new(5, 0) = {arr1}")
let arr2 = array.fill([1, 2, 3], 9)
println("  fill([1,2,3], 9) = {arr2}")
println("")

// 基本操作
println("基本操作:")
let arr = [10, 20, 30, 40, 50]
println("  原始数组: {arr}")
println("  反转: {array.reverse(arr)}")
println("  第一个: {array.first(arr)}")
println("  最后一个: {array.last(arr)}")
println("")

// 查找
println("查找:")
println("  包含 30: {array.contains(arr, 30)}")
println("  包含 99: {array.contains(arr, 99)}")
println("  30 的索引: {array.index_of(arr, 30)}")
println("  99 的索引: {array.index_of(arr, 99)}")
println("  30 出现次数: {array.count(arr, 30)}")
println("")

// 切片和连接
println("切片和连接:")
println("  slice(arr, 1, 3) = {array.slice(arr, 1, 3)}")
println("  concat([1,2], [3,4]) = {array.concat([1, 2], [3, 4])}")
println("")

// 转换
println("转换:")
println("  join(arr, ' - ') = {array.join(arr, " - ")}")
println("  join(['a','b','c'], ',') = {array.join(["a", "b", "c"], ",")}")
println("")

// 修改
println("修改:")
println("  remove(arr, 30) = {array.remove(arr, 30)}")
println("  remove_at(arr, 2) = {array.remove_at(arr, 2)}")
println("  insert_at(arr, 2, 25) = {array.insert_at(arr, 2, 25)}")
