// array - Array manipulation module
// Version: 0.1.0

// Create a new array with n elements initialized to value
fn create(n, value) {
    let result = []
    let i = 0
    while i < n {
        result = concat(result, [value])
        i = i + 1
    }
    return result
}

// Fill array with value
fn fill(arr, value) {
    let result = []
    let i = 0
    let n = len(arr)
    while i < n {
        result = concat(result, [value])
        i = i + 1
    }
    return result
}

// Reverse an array
fn reverse(arr) {
    let result = []
    let i = len(arr)
    while i > 0 {
        i = i - 1
        result = concat(result, [arr[i]])
    }
    return result
}

// Check if array contains value
fn contains(arr, value) {
    let i = 0
    let n = len(arr)
    while i < n {
        if arr[i] == value {
            return true
        }
        i = i + 1
    }
    return false
}

// Find first index of value, -1 if not found
fn index_of(arr, value) {
    let i = 0
    let n = len(arr)
    while i < n {
        if arr[i] == value {
            return i
        }
        i = i + 1
    }
    return -1
}

// Get first element
fn first(arr) {
    if len(arr) == 0 {
        return null
    }
    return arr[0]
}

// Get last element
fn last(arr) {
    let n = len(arr)
    if n == 0 {
        return null
    }
    return arr[n - 1]
}

// Get slice of array [start, end)
fn slice(arr, start, end) {
    let result = []
    let i = start
    while i < end {
        result = concat(result, [arr[i]])
        i = i + 1
    }
    return result
}

// Concatenate two arrays
fn concat(a, b) {
    // Use the built-in + operator for arrays
    return a + b
}

// Join array elements into string
fn join(arr, separator) {
    let result = ""
    let i = 0
    let n = len(arr)
    while i < n {
        if i > 0 {
            result = result + separator
        }
        result = result + to_string(arr[i])
        i = i + 1
    }
    return result
}

// Count occurrences of value
fn count(arr, value) {
    let result = 0
    let i = 0
    let n = len(arr)
    while i < n {
        if arr[i] == value {
            result = result + 1
        }
        i = i + 1
    }
    return result
}

// Remove first occurrence of value
fn remove(arr, value) {
    let result = []
    let found = false
    let i = 0
    let n = len(arr)
    while i < n {
        if arr[i] == value && !found {
            found = true
        } else {
            result = concat(result, [arr[i]])
        }
        i = i + 1
    }
    return result
}

// Remove element at index
fn remove_at(arr, index) {
    let result = []
    let i = 0
    let n = len(arr)
    while i < n {
        if i != index {
            result = concat(result, [arr[i]])
        }
        i = i + 1
    }
    return result
}

// Insert value at index
fn insert_at(arr, index, value) {
    let result = []
    let i = 0
    let n = len(arr)
    while i < n {
        if i == index {
            result = concat(result, [value])
        }
        result = concat(result, [arr[i]])
        i = i + 1
    }
    if index >= n {
        result = concat(result, [value])
    }
    return result
}
